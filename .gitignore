# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.claude

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase temp
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

design-reference

# fixtures reais de NF/CT-e copiados manualmente para testes locais
# (dados de cedentes/sacados reais, com certificados X.509 -- nunca commitar)
nfs
src/lib/logistica/__fixtures__/reais

# rehearsal local de producao (dados reais/sensiveis nunca entram no Git)
.env.rehearsal*
/rehearsal/snapshots/*
!/rehearsal/snapshots/.gitignore
/rehearsal/reports/*
!/rehearsal/reports/.gitignore
/rehearsal/tmp/*
!/rehearsal/tmp/.gitignore
/rehearsal/**/*.dump
/rehearsal/**/*.sql.gz
/rehearsal/**/*.backup
/rehearsal/**/*.cert
/rehearsal/**/*.key
/rehearsal/supabase/.temp/
/rehearsal/supabase/.branches/
/rehearsal/sacado-r2/

